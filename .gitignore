# ==============================================================================
# TrendVibz .gitignore
# Prevents sensitive credentials, environment variables, logs, and build artifacts
# from being committed to source control.
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/

# Environment and Secrets (Confidential)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!*.env.example
!backend/.env.example
!frontend/.env.example

# Private Keys, Certificates, and Credentials
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.pkcs12
id_rsa*
*.pub
credentials.json
*service-account*.json
*secret*.json

# Logs and Process Outputs
*.log
*.err.log
*.out.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Artifacts
dist/
dist-ssr/
frontend/dist/
build/
.vercel/
.turbo/
.output/

# Editor and OS Files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
*.swp
*.swo

# Temporary Files
*.tmp
*.temp
