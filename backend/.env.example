# ==============================================================================
# TrendVibz Backend Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit real secrets or credentials to source control
# ==============================================================================

PORT=5000
JWT_SECRET=your_jwt_secret_here

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/trendvibz?retryWrites=true&w=majority

# Google Cloud OAuth (Optional - for Google Sign-in)
GOOGLE_CLIENT_ID=

# Gmail SMTP Configuration (via Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="TrendVibz" <your_email@gmail.com>

APP_NAME=TrendVibz
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Configuration (for Chatbot)
GEMINI_API_KEY=

# Meta Instagram Graph API Configuration (Optional)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Meta Facebook Graph API Configuration (Optional)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
