# ==============================================================================
# TrendVibe Frontend Environment Variables Template
# Copy this file to .env and configure as needed:
# ==============================================================================

# Backend API Base URL
#
# LOCALHOST (default):
# Leave empty or unset to automatically use http://localhost:5000/api
# VITE_API_URL=http://localhost:5000/api
#
# NGROK EXTERNAL TESTING:
# When exposing the backend via ngrok (e.g., `ngrok http 5000`),
# set this to your backend tunnel URL:
# VITE_API_URL=https://<your-backend-subdomain>.ngrok-free.dev/api
VITE_API_URL=

# Public Frontend Website URL (used to generate direct product links for social posts)
# Leave empty to automatically use the current browser origin (e.g., http://localhost:5173 or https://<subdomain>.ngrok-free.dev)
# VITE_FRONTEND_URL=http://localhost:5173
VITE_FRONTEND_URL=
